# ─── APT Simulator Environment Configuration ───────────────────
# Copy to .env and modify as needed

# MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# Service Ports
HES_PORT=8001
MDMS_PORT=8002
DETECTOR_PORT=8003
DASHBOARD_PORT=3000

# Simulation
METER_COUNT=500
TELEMETRY_INTERVAL_SECONDS=15
SIMULATION_SPEED=1.0

# Database
MDMS_DB_PATH=data/mdms.db

# Attack Event Log
ATTACK_LOG_PATH=data/attack_events.jsonl

# Baseline Model
BASELINE_DIR=data/baseline

# Detection
DETECTION_ENABLED=true
RISK_ALERT_THRESHOLD=65
RISK_BLOCK_THRESHOLD=85
